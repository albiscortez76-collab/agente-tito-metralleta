# Copia este archivo a .env.local y pon tu key real.
MASSIVE_API_KEY=tu_api_key_de_massive
MASSIVE_MAX_PAGES=40

# Cookie de sesión de app.marketsnack.com (para el sub-agente Time & Sales).
# DevTools → Network → request a /api/flow_feed → copia el header "Cookie" completo.
MARKETSNACK_COOKIE=

# App de Charles Schwab (developer.schwab.com) — fuente de bid/ask real.
# Client ID / Secret vienen de "Ver detalles" de tu app. Después de ponerlos,
# corre `node scripts/schwab-auth.mjs` para generar SCHWAB_REFRESH_TOKEN (caduca cada 7 días).
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1
SCHWAB_REFRESH_TOKEN=

# Bot de Telegram para el botón "Enviar a Telegram" del reporte diario.
# Crea el bot con @BotFather, mándale un mensaje, y saca tu chat ID con:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
